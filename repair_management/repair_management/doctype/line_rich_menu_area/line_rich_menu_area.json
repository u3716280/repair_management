{
  "doctype": "DocType",
  "name": "LINE Rich Menu Area",
  "module": "Repair Management",
  "custom": 0,
  "istable": 1,
  "editable_grid": 1,
  "engine": "InnoDB",
  "field_order": [
    "area_label",
    "x",
    "y",
    "width",
    "height",
    "action_type",
    "action_key",
    "message_text",
    "display_text",
    "input_option",
    "fill_in_text",
    "postback_data",
    "uri",
    "datetime_picker_data",
    "datetime_picker_mode",
    "datetime_picker_initial",
    "datetime_picker_min",
    "datetime_picker_max",
    "target_rich_menu",
    "switch_data",
    "clipboard_text",
    "camera_roll_mode",
    "enabled",
    "sort_order"
  ],
  "fields": [
    {
      "fieldname": "area_label",
      "label": "Area Label",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "x",
      "label": "X",
      "fieldtype": "Int",
      "reqd": 1
    },
    {
      "fieldname": "y",
      "label": "Y",
      "fieldtype": "Int",
      "reqd": 1
    },
    {
      "fieldname": "width",
      "label": "Width",
      "fieldtype": "Int",
      "reqd": 1
    },
    {
      "fieldname": "height",
      "label": "Height",
      "fieldtype": "Int",
      "reqd": 1
    },
    {
      "fieldname": "action_type",
      "label": "Action Type",
      "fieldtype": "Select",
      "options": "Postback\nMessage\nURI\nDatetime Picker\nRich Menu Switch\nClipboard\nCamera\nCamera Roll\nLocation",
      "reqd": 1
    },
    {
      "fieldname": "action_key",
      "label": "Action Key",
      "fieldtype": "Data",
      "depends_on": "eval:doc.action_type==\"Postback\" || doc.action_type==\"Datetime Picker\"",
      "description": "Optional action key used as fallback when Action Data is blank."
    },
    {
      "fieldname": "message_text",
      "label": "Message Text",
      "fieldtype": "Small Text",
      "depends_on": "eval:doc.action_type==\"Message\""
    },
    {
      "fieldname": "display_text",
      "label": "Display Text",
      "fieldtype": "Data",
      "depends_on": "eval:doc.action_type==\"Postback\""
    },
    {
      "fieldname": "input_option",
      "fieldtype": "Select",
      "label": "Input Option",
      "options": "\ncloseRichMenu\nopenRichMenu\nopenKeyboard\nopenVoice",
      "depends_on": "eval:doc.action_type==\"Postback\"",
      "description": "LINE postback inputOption."
    },
    {
      "fieldname": "fill_in_text",
      "fieldtype": "Data",
      "label": "Fill In Text",
      "length": 300,
      "depends_on": "eval:doc.action_type==\"Postback\" && doc.input_option==\"openKeyboard\"",
      "description": "Optional LINE fillInText, used only with openKeyboard."
    },
    {
      "fieldname": "postback_data",
      "label": "Postback Data",
      "fieldtype": "Small Text",
      "depends_on": "eval:doc.action_type==\"Postback\""
    },
    {
      "fieldname": "uri",
      "label": "URI",
      "fieldtype": "Small Text",
      "depends_on": "eval:doc.action_type==\"URI\"",
      "mandatory_depends_on": "eval:doc.action_type==\"URI\""
    },
    {
      "fieldname": "datetime_picker_data",
      "label": "Datetime Picker Data",
      "fieldtype": "Small Text",
      "depends_on": "eval:doc.action_type==\"Datetime Picker\"",
      "description": "Postback data returned after the user selects a date/time. If blank, Action Key is used as action=<key>."
    },
    {
      "fieldname": "datetime_picker_mode",
      "label": "Datetime Picker Mode",
      "fieldtype": "Select",
      "options": "date\ntime\ndatetime",
      "default": "date",
      "depends_on": "eval:doc.action_type==\"Datetime Picker\"",
      "mandatory_depends_on": "eval:doc.action_type==\"Datetime Picker\""
    },
    {
      "fieldname": "datetime_picker_initial",
      "label": "Initial",
      "fieldtype": "Data",
      "depends_on": "eval:doc.action_type==\"Datetime Picker\"",
      "description": "date: YYYY-MM-DD, time: HH:mm, datetime: YYYY-MM-DDTHH:mm"
    },
    {
      "fieldname": "datetime_picker_min",
      "label": "Min",
      "fieldtype": "Data",
      "depends_on": "eval:doc.action_type==\"Datetime Picker\"",
      "description": "Minimum selectable value using the same format as Mode."
    },
    {
      "fieldname": "datetime_picker_max",
      "label": "Max",
      "fieldtype": "Data",
      "depends_on": "eval:doc.action_type==\"Datetime Picker\"",
      "description": "Maximum selectable value using the same format as Mode."
    },
    {
      "fieldname": "target_rich_menu",
      "label": "Target Rich Menu",
      "fieldtype": "Link",
      "options": "LINE Rich Menu Definition",
      "depends_on": "eval:doc.action_type==\"Rich Menu Switch\"",
      "mandatory_depends_on": "eval:doc.action_type==\"Rich Menu Switch\"",
      "description": "Target definition. Backend resolves its Alias ID; users do not type the alias manually."
    },
    {
      "fieldname": "switch_data",
      "label": "Switch Data",
      "fieldtype": "Small Text",
      "depends_on": "eval:doc.action_type==\"Rich Menu Switch\"",
      "description": "Optional postback data. Defaults to action=richmenu_switch&menu=<target alias>."
    },
    {
      "fieldname": "clipboard_text",
      "label": "Clipboard Text",
      "fieldtype": "Small Text",
      "depends_on": "eval:doc.action_type==\"Clipboard\"",
      "mandatory_depends_on": "eval:doc.action_type==\"Clipboard\"",
      "description": "Text copied to the user's clipboard. LINE limit: 1000 characters."
    },
    {
      "fieldname": "camera_roll_mode",
      "label": "Selection Mode",
      "fieldtype": "Select",
      "options": "Single\nMulti",
      "default": "Multi",
      "depends_on": "eval:doc.action_type==\"Camera Roll\"",
      "mandatory_depends_on": "eval:doc.action_type==\"Camera Roll\"",
      "description": "Camera Roll opens through LINE URL scheme. Single selects one image; Multi selects multiple images."
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "sort_order",
      "label": "Sort Order",
      "fieldtype": "Int"
    }
  ],
  "permissions": [],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1
}
