{
 "doctype": "DocType",
 "name": "LINE Rich Menu Area",
 "module": "Repair Management",
 "custom": 0,
 "istable": 1,
 "editable_grid": 1,
 "engine": "InnoDB",
 "field_order": [
  "area_label",
  "x",
  "y",
  "width",
  "height",
  "action_type",
  "action_key",
  "message_text",
  "display_text",
  "input_option",
  "fill_in_text",
  "postback_data",
  "uri",
  "enabled",
  "sort_order"
 ],
 "fields": [
  {
   "fieldname": "area_label",
   "label": "Area Label",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "x",
   "label": "X",
   "fieldtype": "Int",
   "reqd": 1
  },
  {
   "fieldname": "y",
   "label": "Y",
   "fieldtype": "Int",
   "reqd": 1
  },
  {
   "fieldname": "width",
   "label": "Width",
   "fieldtype": "Int",
   "reqd": 1
  },
  {
   "fieldname": "height",
   "label": "Height",
   "fieldtype": "Int",
   "reqd": 1
  },
  {
   "fieldname": "action_type",
   "label": "Action Type",
   "fieldtype": "Select",
   "options": "Postback\nMessage\nURI",
   "reqd": 1
  },
  {
   "fieldname": "action_key",
   "label": "Action Key",
   "fieldtype": "Data"
  },
  {
   "fieldname": "message_text",
   "label": "Message Text",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "display_text",
   "label": "Display Text",
   "fieldtype": "Data"
  },
  {
   "fieldname": "postback_data",
   "label": "Postback Data",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "uri",
   "label": "URI",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "enabled",
   "label": "Enabled",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "sort_order",
   "label": "Sort Order",
   "fieldtype": "Int"
  },
  {
   "fieldname": "input_option",
   "fieldtype": "Select",
   "label": "Input Option",
   "options": "\ncloseRichMenu\nopenRichMenu\nopenKeyboard\nopenVoice",
   "depends_on": "eval:doc.action_type==\"Postback\"",
   "description": "LINE postback inputOption."
  },
  {
   "fieldname": "fill_in_text",
   "fieldtype": "Data",
   "label": "Fill In Text",
   "length": 300,
   "depends_on": "eval:doc.action_type==\"Postback\" && doc.input_option==\"openKeyboard\"",
   "description": "Optional LINE fillInText, used only with openKeyboard."
  }
 ],
 "permissions": [],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1
}
